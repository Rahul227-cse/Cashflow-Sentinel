# Production/demo uses Exasol; never commit a populated .env file.
CASHFLOW_STORE=exasol
EXASOL_DSN=127.0.0.1:8563
EXASOL_USER=sys
EXASOL_PASSWORD=replace-with-local-secret
EXASOL_SCHEMA=CFS_DEMO
# Set true only for Exasol Personal's loopback self-signed certificate.
EXASOL_INSECURE_TLS=false
# SQLite is only for isolated tests: CASHFLOW_STORE=sqlite
DATABASE_URL=sqlite:///cashflow_sentinel.db
FLASK_ENV=development
